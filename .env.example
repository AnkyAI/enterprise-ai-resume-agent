# Change this before exposing the service outside localhost.
RESUME_API_KEYS=dev-secret-key
RESUME_ENVIRONMENT=development
RESUME_LOG_LEVEL=INFO
RESUME_RATE_LIMIT_REQUESTS=60
RESUME_RATE_LIMIT_WINDOW_SECONDS=60

# Free local LLM option. Install Ollama, run `ollama pull llama3.2:3b`, then
# change deterministic to ollama. No paid API key is required.
RESUME_AI_PROVIDER=deterministic
RESUME_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESUME_OLLAMA_MODEL=llama3.2:3b
RESUME_OLLAMA_TIMEOUT_SECONDS=90
RESUME_ALLOW_DETERMINISTIC_FALLBACK=true

